diff --git a/packages/sdl3-ttf.cmake b/packages/sdl3-ttf.cmake
new file mode 100644
index 0000000..d97c73c
--- /dev/null
+++ b/packages/sdl3-ttf.cmake
@@ -0,0 +1,27 @@
+ExternalProject_Add(
+  sdl3-ttf
+  DEPENDS freetype2
+          harfbuzz
+          sdl3
+  URL https://github.com/libsdl-org/SDL_ttf/releases/download/release-3.2.2/SDL3_ttf-3.2.2.tar.gz
+  URL_HASH SHA256=63547d58d0185c833213885b635a2c0548201cc8f301e6587c0be1a67e1e045d
+  DOWNLOAD_EXTRACT_TIMESTAMP 1
+  CONFIGURE_COMMAND
+    ${EXEC} cmake -H<SOURCE_DIR> -B<BINARY_DIR>
+    ${cmake_conf_args}
+    -DSDLTTF_HARFBUZZ=ON
+    -DSDLTTF_INSTALL=ON
+    -DSDLTTF_INSTALL_CPACK=OFF
+    -DSDLTTF_INSTALL_MAN=OFF
+    -DSDLTTF_PLUTOSVG=OFF
+    -DSDLTTF_SAMPLES=OFF
+    -DSDLTTF_STRICT=ON
+    -DSDLTTF_VENDORED=OFF
+    -DSDLTTF_WERROR=OFF
+  BUILD_COMMAND ${NINJA} -C <BINARY_DIR>
+  INSTALL_COMMAND ${NINJA} install
+  LOG_DOWNLOAD 1
+  LOG_UPDATE 1
+  LOG_CONFIGURE 1
+  LOG_BUILD 1
+  LOG_INSTALL 1)
